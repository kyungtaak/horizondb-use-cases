# Azure HorizonDB
AZURE_PG_HOST=
AZURE_PG_NAME=
AZURE_PG_USER=
AZURE_PG_PASSWORD=
AZURE_PG_PORT=5432
AZURE_PG_SSLMODE=require

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5.4
AZURE_EMBED_DEPLOYMENT=text-embedding-3-small
EMBEDDING_MODEL_ALIAS=horizonship-embedding
MODEL_REGISTRY_AUTH_TYPE=subscription-key
# For managed-identity registry auth, attach an identity to HorizonDB and grant model access.
AZURE_CLIENT_ID=

# Select model invocation per operation: azure_openai or horizondb
CHAT_PROVIDER=azure_openai
CHAT_MODEL_ALIAS=horizonship-chat
EMBEDDING_PROVIDER=azure_openai
MODEL_TIMEOUT_SECONDS=45
SEARCH_TIMEZONE=Asia/Seoul
CAPTURE_QUERY_PLAN=false

# Connection pool
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=5
DATABASE_CONNECT_TIMEOUT_SECONDS=10

# Home shopping is opt-in; its model aliases do not change Fleet.
COMMERCE_ENABLED=false
COMMERCE_CLASSIFIER_ALIAS=horizonshop-classifier
COMMERCE_CLASSIFIER_DEPLOYMENT=gpt-5.4-mini
COMMERCE_BRIEFING_ALIAS=horizonshop-briefing
COMMERCE_BRIEFING_DEPLOYMENT=gpt-5.4-mini
# Override only when shopping uses a different Foundry account from Fleet.
# COMMERCE_MODEL_ENDPOINT=https://your-model-account.openai.azure.com/
# COMMERCE_MODEL_AUTH_TYPE=managed-identity
# COMMERCE_MODEL_KEY=